<% content_for :title, title %>

<section class="mx-auto max-w-2xl px-5 py-20 text-center">
  <p class="font-display text-sm font-semibold uppercase tracking-widest text-terracota">Em construção</p>
  <h1 class="mt-3 font-display text-3xl font-semibold tracking-tight text-vinho sm:text-4xl"><%= title %></h1>
  <p class="mx-auto mt-4 max-w-lg text-base text-presenca/80"><%= description %></p>
  <%= link_to "Voltar para o início", root_path,
        class: "mt-8 inline-flex items-center rounded-full border border-vinho px-5 py-2.5 text-sm font-semibold text-vinho hover:bg-vinho hover:text-offwhite transition-colors" %>
</section>
