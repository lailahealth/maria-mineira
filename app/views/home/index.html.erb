<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 -top-24 flex justify-center" aria-hidden="true">
    <div class="h-[28rem] w-[28rem] rounded-[40%_60%_65%_35%/45%_45%_55%_55%] bg-gradient-to-br from-blush via-rosa/70 to-terracota/40 blur-3xl opacity-50"></div>
  </div>

  <div class="relative mx-auto grid max-w-5xl items-center gap-6 px-5 pb-16 pt-16 sm:pt-24 lg:grid-cols-[1.1fr_0.9fr] lg:gap-10">
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-blush/70 px-4 py-1.5 text-xs font-semibold text-vinho">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20.5c-.3 0-.6-.1-.8-.3C7.8 17.4 4 14.2 4 10.3 4 7.9 5.9 6 8.3 6c1.4 0 2.7.7 3.5 1.8C12.6 6.7 13.9 6 15.3 6 17.7 6 19.6 7.9 19.6 10.3c0 3.9-3.8 7.1-7.2 9.9-.2.2-.5.3-.8.3z"/>
        </svg>
        Gratuita, sigilosa e independente
      </span>

      <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight text-vinho sm:text-5xl">
        Como a Maria Mineira pode te ajudar hoje?
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-presenca/80 lg:mx-0">
        Conte com suas próprias palavras o que você está buscando. A Maria Mineira te ajuda a
        entender, orientar e encontrar informação e apoio perto de você.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <%= link_to chat_path,
              class: "inline-flex w-full items-center justify-center rounded-full bg-vinho px-7 py-3.5 text-base font-semibold text-offwhite shadow-sm hover:bg-vinho/90 transition-colors sm:w-auto" do %>
          Conversar com a Maria Mineira
        <% end %>
        <%= link_to "Prefiro ver o mapa de serviços", map_page_path,
              class: "text-sm font-semibold text-vinho underline decoration-vinho/40 underline-offset-4 hover:decoration-vinho" %>
      </div>

      <p class="mt-6 text-xs text-presenca/60">
        Você não precisa saber qual órgão ou serviço procurar — nem se identificar para conversar.
      </p>
    </div>

    <div class="hidden lg:flex lg:justify-center" aria-hidden="true">
      <div class="flex size-72 items-center justify-center rounded-[45%_55%_60%_40%/50%_45%_55%_50%] bg-gradient-to-br from-blush via-rosa/25 to-transparent">
        <%= image_tag "brand/symbol-rosa.svg", alt: "", class: "w-36 drop-shadow-sm" %>
      </div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-5xl px-5 pb-16">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="font-display text-2xl font-semibold tracking-tight text-vinho sm:text-3xl">
      Um espaço pensado para acolher você
    </h2>
    <p class="mt-3 text-sm text-presenca/70">
      Iniciativa independente de Minas Gerais — sem vínculo institucional, partidário ou governamental.
    </p>
  </div>

  <dl class="mt-10 grid gap-8 sm:grid-cols-3">
    <div class="text-center">
      <dt class="flex flex-col items-center gap-3">
        <span class="inline-flex size-12 items-center justify-center rounded-full bg-blush text-vinho" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 20.5c-.3 0-.6-.1-.8-.3C7.8 17.4 4 14.2 4 10.3 4 7.9 5.9 6 8.3 6c1.4 0 2.7.7 3.5 1.8C12.6 6.7 13.9 6 15.3 6 17.7 6 19.6 7.9 19.6 10.3c0 3.9-3.8 7.1-7.2 9.9-.2.2-.5.3-.8.3z"/>
          </svg>
        </span>
        <span class="font-display text-base font-semibold text-presenca">Acolhimento</span>
      </dt>
      <dd class="mt-2 text-sm text-presenca/75">
        Você é ouvida antes de tudo no seu tempo, sem pressa e sem julgamento.
      </dd>
    </div>

    <div class="text-center">
      <dt class="flex flex-col items-center gap-3">
        <span class="inline-flex size-12 items-center justify-center rounded-full bg-rosa/25 text-vinho" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 7c-1.8-1.4-4.3-2-6.5-1.5-.6.1-1 .6-1 1.2v10.6c0 .5.5.9 1 .8 2.1-.4 4.4.1 6.5 1.4 2.1-1.3 4.4-1.8 6.5-1.4.5.1 1-.3 1-.8V6.7c0-.6-.4-1.1-1-1.2C16.3 5 13.8 5.6 12 7z"/>
            <path d="M12 7v11"/>
          </svg>
        </span>
        <span class="font-display text-base font-semibold text-presenca">Informação</span>
      </dt>
      <dd class="mt-2 text-sm text-presenca/75">
        Direitos e políticas públicas explicados de um jeito simples de entender.
      </dd>
    </div>

    <div class="text-center">
      <dt class="flex flex-col items-center gap-3">
        <span class="inline-flex size-12 items-center justify-center rounded-full bg-terracota/20 text-terracota" aria-hidden="true">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6l7-3z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </span>
        <span class="font-display text-base font-semibold text-presenca">Segurança</span>
      </dt>
      <dd class="mt-2 text-sm text-presenca/75">
        Cuidado, sigilo e responsabilidade em cada etapa da conversa.
      </dd>
    </div>
  </dl>
</section>

<section class="mx-auto max-w-5xl px-5 pb-20">
  <h2 class="text-center font-display text-2xl font-semibold tracking-tight text-presenca sm:text-left">
    Ou explore por conta própria
  </h2>

  <div class="mt-6 grid gap-5 sm:grid-cols-3">
    <%= link_to violence_types_path, class: "group rounded-3xl bg-rosa p-6 transition-transform hover:-translate-y-0.5" do %>
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-offwhite/70 text-vinho" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9"/>
          <line x1="12" y1="11" x2="12" y2="16.5"/>
          <circle cx="12" cy="7.6" r="1" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      <p class="mt-4 font-display text-lg font-semibold text-presenca">Tipos de violência</p>
      <p class="mt-2 text-sm text-presenca/80">Conceitos e informações educativas sobre os diferentes tipos de violência contra a mulher.</p>
      <span class="mt-4 inline-flex items-center text-sm font-semibold text-presenca">
        Conhecer <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
      </span>
    <% end %>

    <%= link_to map_page_path, class: "group rounded-3xl bg-blush p-6 transition-transform hover:-translate-y-0.5" do %>
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-offwhite/70 text-vinho" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21s-7-6.1-7-11.5C5 6.5 8.1 3.5 12 3.5s7 3 7 6c0 5.4-7 11.5-7 11.5z"/>
          <circle cx="12" cy="9.8" r="2.3"/>
        </svg>
      </span>
      <p class="mt-4 font-display text-lg font-semibold text-presenca">Encontre um serviço</p>
      <p class="mt-2 text-sm text-presenca/80">Veja no mapa os equipamentos e serviços de apoio mais próximos de você em Minas Gerais.</p>
      <span class="mt-4 inline-flex items-center text-sm font-semibold text-presenca">
        Ver mapa <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
      </span>
    <% end %>

    <%= link_to rights_path, class: "group rounded-3xl bg-terracota p-6 text-offwhite transition-transform hover:-translate-y-0.5" do %>
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-offwhite/90 text-terracota" aria-hidden="true">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v18M6 21h12M4 6h7M13 6h7"/>
          <path d="M4 6l-2.5 5a2.5 2.5 0 0 0 5 0L4 6z"/>
          <path d="M20 6l-2.5 5a2.5 2.5 0 0 0 5 0L20 6z"/>
        </svg>
      </span>
      <p class="mt-4 font-display text-lg font-semibold">Direitos</p>
      <p class="mt-2 text-sm text-offwhite/85">Entenda seus direitos e as políticas públicas que existem para as mulheres em Minas Gerais.</p>
      <span class="mt-4 inline-flex items-center text-sm font-semibold">
        Entender <span class="ml-1 transition-transform group-hover:translate-x-0.5">→</span>
      </span>
    <% end %>
  </div>
</section>
