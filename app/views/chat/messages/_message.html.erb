<% if message.user? %>
  <div class="flex justify-end">
    <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-vinho px-4 py-2.5 text-sm text-offwhite">
      <%= message.body %>
    </div>
  </div>
<% elsif message.card_type_emergencia? %>
  <div class="flex justify-start gap-2">
    <%= render "chat/messages/avatar" %>
    <div class="max-w-[85%] space-y-2">
      <div class="rounded-2xl rounded-bl-sm border border-terracota bg-terracota/10 px-4 py-3 text-sm text-presenca">
        <p class="font-semibold text-terracota">Se você está em risco agora</p>
        <p class="mt-1"><%= message.body %></p>
        <div class="mt-3 flex flex-wrap gap-2">
          <%= link_to "Ligar 190 (Polícia)", tel_href("190"),
                class: "inline-flex items-center gap-1 rounded-full bg-terracota px-3 py-1.5 text-xs font-semibold text-offwhite hover:opacity-90" %>
          <%= link_to "Ligar 180 (Central da Mulher)", tel_href("180"),
                class: "inline-flex items-center gap-1 rounded-full border border-terracota px-3 py-1.5 text-xs font-semibold text-terracota hover:bg-terracota hover:text-offwhite" %>
        </div>
      </div>
    </div>
  </div>
<% elsif message.card_type_municipio_sem_cobertura? %>
  <div class="flex justify-start gap-2">
    <%= render "chat/messages/avatar" %>
    <div class="max-w-[85%] rounded-2xl rounded-bl-sm border border-terracota/40 bg-blush/30 px-4 py-2.5 text-sm text-presenca">
      <%= message.body %>
    </div>
  </div>
<% elsif message.card_type_facility_results? %>
  <% payload = JSON.parse(message.body) rescue { "text" => message.body, "facility_ids" => [] } %>
  <div class="flex justify-start gap-2">
    <%= render "chat/messages/avatar" %>
    <div class="max-w-[85%] space-y-2">
      <div class="rounded-2xl rounded-bl-sm bg-blush/40 px-4 py-2.5 text-sm text-presenca"><%= payload["text"] %></div>
      <% facilities_by_id = Territorial::Facility.includes(:municipality).where(id: payload["facility_ids"]).index_by(&:id) %>
      <% payload["facility_ids"].each_with_index do |id, index| %>
        <% facility = facilities_by_id[id] %>
        <% next unless facility %>
        <% distance = payload.dig("distances_km", index) %>
        <div class="rounded-2xl border border-blush bg-white px-4 py-3 text-sm">
          <%= link_to facility.name, territorial_facility_path(facility),
                class: "font-semibold text-vinho hover:underline" %>
          <p class="text-presenca/70"><%= facility.facility_type %> · <%= facility.municipality.name %></p>
          <% if distance %>
            <p class="mt-1 text-xs font-semibold text-vinho">A aproximadamente <%= distance %> km de você</p>
          <% end %>
          <% if facility.address.present? %>
            <p class="mt-1 text-presenca/70"><%= facility.address %></p>
          <% end %>
          <div class="mt-2 flex flex-wrap gap-2">
            <%= link_to "Como chegar", facility_directions_url(facility),
                  target: "_blank", rel: "noopener",
                  class: "inline-flex items-center gap-1 rounded-full bg-vinho px-3 py-1.5 text-xs font-semibold text-offwhite hover:bg-vinho/90" %>
            <% if facility.phone.present? %>
              <%= link_to "Ligar #{facility.phone}", tel_href(facility.phone),
                    class: "inline-flex items-center gap-1 rounded-full border border-vinho px-3 py-1.5 text-xs font-semibold text-vinho hover:bg-vinho hover:text-offwhite" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="flex justify-start gap-2">
    <%= render "chat/messages/avatar" %>
    <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-blush/40 px-4 py-2.5 text-sm text-presenca">
      <%= message.body %>
    </div>
  </div>
<% end %>
