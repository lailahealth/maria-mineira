<% content_for :title, "Converse com a Maria Mineira" %>
<%# No celular o cabeçalho do site sai para sobrar espaço acima do teclado; o link "‹" abaixo leva de volta ao início. %>
<% content_for :hide_header_on_mobile, true %>
<%# O rodapé também sai: o chat ocupa a tela inteira (h-dvh), e com o rodapé embaixo o navegador às vezes rolava a página até ele ao abrir/fechar o teclado. %>
<% content_for :hide_footer_on_mobile, true %>

<section data-controller="chat-viewport"
         class="mx-auto flex h-dvh max-w-2xl flex-col px-0 sm:h-[calc(100vh-73px)] sm:px-5">
  <div class="flex items-start justify-between gap-3 border-b border-blush bg-offwhite px-5 py-4 sm:rounded-t-3xl sm:border-x sm:border-t">
    <%= link_to root_path, aria: { label: "Voltar ao início" },
          class: "-ml-2 -my-1 shrink-0 rounded-full p-2 text-vinho hover:bg-blush/40 sm:hidden" do %>
      <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
      </svg>
    <% end %>
    <div class="flex-1">
      <p class="font-display text-lg font-semibold text-vinho">Maria Mineira</p>
      <p class="text-xs text-presenca/60">Orientação e informação — não é um canal de denúncia.</p>
    </div>
    <%= button_to "Encerrar conversa", chat_path, method: :delete,
          data: { turbo_confirm: "Isso apaga esta conversa e volta para o início. Continuar?" },
          class: "shrink-0 whitespace-nowrap text-xs font-semibold text-presenca/60 hover:text-vinho hover:underline" %>
  </div>

  <div id="messages" data-controller="chat-scroll chat-typing"
       data-action="turbo:submit-start@document->chat-typing#start turbo:submit-end@document->chat-typing#end"
       class="flex-1 space-y-3 overflow-y-auto bg-white px-4 py-5 sm:border-x">
    <%= render @messages %>
  </div>

  <div id="composer" class="border-t border-blush bg-offwhite px-4 py-4 sm:rounded-b-3xl sm:border-x sm:border-b">
    <%= render "chat/conversations/composer", conversation: @conversation %>
  </div>
</section>
